{
  "name": "masterportal-addons-e2e",
  "version": "1.0.0",
  "description": "E2E tests for masterportal-addons against the Masterportal LTS build",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:addon": "ADDON_NAME=${ADDON_NAME} playwright test --config=playwright.config.js",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "wait-on": "^7.2.0"
  }
}
